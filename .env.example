# Copy to .env.local and fill in to use Google Maps instead of OpenStreetMap.
# Restrict the key to HTTP referrers (localhost + your Pages URL) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud (Map Management). Defaults to DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
