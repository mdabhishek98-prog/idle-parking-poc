{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Booking Status Lifecycle",
    "locale": "en",
    "output": "diagrams/build/booking-status/booking-status.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "main", "label": "Normal path" },
    { "id": "attention", "label": "Needs attention" },
    { "id": "terminal", "label": "Closed early" }
  ],
  "states": [
    { "id": "booked", "type": "start", "label": "Booked", "sublabel": "paid, QR issued", "lane": "main", "col": 0, "step": "01" },
    { "id": "parked", "type": "active", "label": "Checked in", "sublabel": "car on the lot", "lane": "main", "col": 1, "step": "02" },
    { "id": "completed", "type": "active", "label": "Completed", "sublabel": "checked out", "lane": "main", "col": 2, "step": "03" },
    { "id": "paidout", "type": "success", "label": "Paid out", "sublabel": "owner credited", "lane": "main", "col": 3, "step": "04" },
    { "id": "overstay", "type": "waiting", "label": "Overstay", "sublabel": "past booked end", "lane": "attention", "col": 1 },
    { "id": "disputed", "type": "decision", "label": "Disputed", "sublabel": "support reviews", "lane": "attention", "col": 2 },
    { "id": "cancelled", "type": "failure", "label": "Cancelled", "sublabel": "before check-in", "lane": "terminal", "col": 0 },
    { "id": "refunded", "type": "failure", "label": "Refunded", "sublabel": "dispute upheld", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "id": "check-in", "from": "booked", "to": "parked", "label": "check in", "variant": "emphasis" },
    { "id": "check-out", "from": "parked", "to": "completed", "label": "check out", "variant": "emphasis" },
    { "id": "nightly", "from": "completed", "to": "paidout", "label": "nightly job", "variant": "emphasis" },
    { "id": "time-up", "from": "parked", "to": "overstay", "label": "time up", "variant": "default" },
    { "id": "late-out", "from": "overstay", "to": "completed", "label": "check out", "variant": "default" },
    { "id": "problem", "from": "completed", "to": "disputed", "label": "problem", "variant": "dashed" },
    { "id": "closed", "from": "disputed", "to": "paidout", "label": "closed", "variant": "default" },
    { "id": "refund", "from": "disputed", "to": "refunded", "label": "refund", "variant": "security" },
    { "id": "cancel", "from": "booked", "to": "cancelled", "label": "cancel", "variant": "security" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Normal path", "items": ["Owner's gate screen moves a booking from booked to completed", "The nightly payout job marks it paid out"] },
    { "dot": "amber", "title": "Needs attention", "items": ["Overstay is flagged on the owner's screen", "Either side can raise a dispute"] },
    { "dot": "rose", "title": "Closed early", "items": ["Drivers can cancel before check-in", "A refund is only possible before the payout"] }
  ]
}
